{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppSecretsProd",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:258084617016:secret:ceseelia/prod-??????"
    },
    {
      "Sid": "TableProd",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:258084617016:table/ceseelia_prod",
        "arn:aws:dynamodb:us-east-1:258084617016:table/ceseelia_prod/index/*"
      ]
    },
    {
      "Sid": "StorageProdObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutObjectTagging",
        "s3:DeleteObjectTagging",
        "s3:GetObjectTagging"
      ],
      "Resource": "arn:aws:s3:::ceseelia-storage-prod/*"
    },
    {
      "Sid": "StorageProdList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ceseelia-storage-prod"
    },
    {
      "Sid": "UserPoolProd",
      "Effect": "Allow",
      "Action": "cognito-idp:AdminGetUser",
      "Resource": "arn:aws:cognito-idp:us-east-1:258084617016:userpool/us-east-1_YLhkkYbV5"
    },
    {
      "Sid": "EmailFromCeseelia",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-1:258084617016:identity/ceseelia.com"
    },
    {
      "Sid": "ApiLogsProd",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:258084617016:log-group:/ceseelia/prod/api",
        "arn:aws:logs:us-east-1:258084617016:log-group:/ceseelia/prod/api:log-stream:*"
      ]
    }
  ]
}
