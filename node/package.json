{
  "name": "ceseelia_api",
  "version": "1.0.0",
  "description": "Ceseelia Backend API",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "nodemonConfig": {
    "ext": "js,html,css"
  },
  "author": "",
  "license": "ISC",
