# Copy to .env and adjust. Never commit .env.

# dev | prod
STAGE=dev
HOST=0.0.0.0
PORT=3100

# Comma-separated hostnames routed to the API (dev also accepts localhost + this machine's IPs)
ALLOWED_API_HOSTS=api.ceseelia.com
# Comma-separated browser origins allowed by CORS. Required when STAGE=prod.
# Leave empty in dev to allow any origin.
CORS_ORIGINS=

# Number of proxies in front of the API that add X-Forwarded-For (nginx = 1; nginx behind
# CloudFront = 2). The client IP is read from that many hops back, so it can't be spoofed.
# TRUST_PROXY_HOPS=1

# Webapp base URL for links in emails (default: http://localhost:4200 in dev,
# https://app.ceseelia.com in prod)
# WEBAPP_URL=

# Optional overrides (defaults are derived from STAGE)
# DB_TABLE_NAME=ceseelia_dev
# S3_STORAGE_BUCKET_NAME=ceseelia-storage-dev
# S3_STORAGE_BUCKET_ORIGIN=https://dev.storage.ceseelia.com/
# COGNITO_USER_POOL_ID=
# COGNITO_USER_POOL_CLIENT_ID=

# Only needed for federated (social) sign-in
# COGNITO_USER_POOL_CLIENT_SECRET=
# COGNITO_AUTH_DOMAIN=https://auth.example.com/oauth2/token
# COGNITO_FEDERATION_REDIRECT_URL=

# AWS credentials come from the standard chain (AWS_PROFILE, env vars, or the EC2 instance role)
